{
  "manifest_version": 3,
  "name": "店策 Agent - 多浏览器兼容版",
  "version": "4.14.9",
  "key": "",
  "description": "适配 360、QQ、搜狗、联想等 Chromium 浏览器；轻量哨兵默认零自动扫描，支持千川官方 API 与网页采集双通道。",
  "minimum_chrome_version": "109",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://fxg.jinritemai.com/*",
    "https://qianchuan.jinritemai.com/*",
    "https://buyin.jinritemai.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://fxg.jinritemai.com/*"],
      "js": ["content-common.js", "content-doudian.js", "platform-assistant.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://qianchuan.jinritemai.com/*", "https://buyin.jinritemai.com/*"],
      "js": ["content-common.js", "content-qianchuan.js", "platform-assistant.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "打开店策 Agent 轻量哨兵",
    "default_popup": "popup.html"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
