{
  "manifest_version": 3,
  "name": "店策 Agent - 抖店千川经营副驾",
  "version": "3.3.0",
  "description": "轻量哨兵默认零自动扫描，按需连接巨量千川官方 API 与已登录网页，在独立工作台中完成经营分析。",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://fxg.jinritemai.com/*",
    "https://qianchuan.jinritemai.com/*",
    "https://buyin.jinritemai.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://fxg.jinritemai.com/*"],
      "js": ["content-common.js", "content-doudian.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://qianchuan.jinritemai.com/*", "https://buyin.jinritemai.com/*"],
      "js": ["content-common.js", "content-qianchuan.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "打开店策 Agent 轻量哨兵",
    "default_popup": "popup.html"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
