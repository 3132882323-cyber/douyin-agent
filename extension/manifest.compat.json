{
  "manifest_version": 3,
  "name": "店策 Agent - 多浏览器兼容版",
  "version": "2.16.0",
  "description": "适配 360 安全浏览器、QQ 浏览器、搜狗浏览器、联想浏览器等 Chromium 浏览器；经营工作台使用新标签页打开。",
  "minimum_chrome_version": "109",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://fxg.jinritemai.com/*",
    "https://qianchuan.jinritemai.com/*",
    "https://buyin.jinritemai.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://fxg.jinritemai.com/*"],
      "js": ["content-common.js", "content-doudian.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://qianchuan.jinritemai.com/*", "https://buyin.jinritemai.com/*"],
      "js": ["content-common.js", "content-qianchuan.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "打开店策 Agent 经营工作台"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
