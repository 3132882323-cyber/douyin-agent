# Public mode selection. Unknown values fail closed.
DIAN_AGENT_DEPLOYMENT_MODE=doudian_marketplace
DIAN_AGENT_ALLOWED_WEB_ORIGINS=https://console.example.com

# Inject real values from a secrets manager. Never commit secrets.
DIAN_AGENT_DOUDIAN_APP_KEY=
DIAN_AGENT_DOUDIAN_APP_SECRET=
DIAN_AGENT_DOUDIAN_CALLBACK_URL=https://api.example.com/oauth/doudian/callback

# These flags must only be set by a protected release environment after review.
DIAN_AGENT_ENTERPRISE_NAME=
DIAN_AGENT_ENTERPRISE_VERIFIED=false
DIAN_AGENT_DOUDIAN_PROVIDER_APPROVED=false
DIAN_AGENT_DOUDIAN_APP_APPROVED=false
DIAN_AGENT_DOUDIAN_API_CONTRACT_APPROVED=false
DIAN_AGENT_TOKEN_STORE_BACKEND=unconfigured
DIAN_AGENT_OAUTH_STATE_BACKEND=unconfigured
DIAN_AGENT_AUTH_GATEWAY_CONFIGURED=false
DIAN_AGENT_SECURITY_REVIEW_PASSED=false

# Public legal and support materials.
DIAN_AGENT_PRIVACY_URL=
DIAN_AGENT_TERMS_URL=
DIAN_AGENT_DATA_DELETION_URL=
DIAN_AGENT_SUPPORT_URL=
DIAN_AGENT_CUSTOMER_SERVICE=
DIAN_AGENT_ICP_FILING=
